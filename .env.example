# Optional API base for production (leave empty for local-only static hosting)
# VITE_API_BASE=https://your-api.example.com

# Backend listen port (default 3851)
# CRRT_API_PORT=3851

# Halal Daily Movers price provider: yahoo | alphavantage | polygon | simulated
VITE_PRICE_PROVIDER=yahoo

# Optional — override CORS proxy for production (use {url} placeholder)
# VITE_PRICE_PROXY_URL=https://api.allorigins.win/raw?url={url}

# Optional fallbacks / alternate providers
# VITE_ALPHA_VANTAGE_KEY=your_key
# VITE_POLYGON_KEY=your_key
